# Where the enquiry form posts its JSON. Works with Formspree, Web3Forms-style
# JSON endpoints, or your own backend / serverless function.
# Leave empty and the form will honestly tell visitors it is not connected yet.
VITE_FORM_ENDPOINT=

# Public contact details (leave empty to show clearly-marked placeholders)
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_INSTAGRAM_URL=
VITE_LOCATION=
VITE_SITE_URL=
